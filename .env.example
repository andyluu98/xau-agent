# --- MT5 (Exness demo) ---
MT5_LOGIN=12345678
MT5_PASSWORD=changeme
MT5_SERVER=Exness-MT5Trial
MT5_TERMINAL_PATH=

# --- LLM ---
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# --- News / Web ---
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxx

# --- TradingView consensus (free, no auth) ---
TV_SYMBOL=XAUUSD
TV_EXCHANGE=OANDA
TV_SCREENER=cfd

# --- Trading params (override defaults in config.py) ---
SYMBOL=XAUUSD
ENTRY_TF=M15
TREND_TFS=H1,H4
DEFAULT_LOT=0.01
MAX_OPEN_TRADES=1
MAX_TRADES_PER_DAY=4
ATR_SL_MULT=1.5
ATR_TP_MULT=2.5

# --- Risk management ---
RISK_PCT_PER_TRADE=0.0    # 0=dùng DEFAULT_LOT. >0 (vd 1.0)=tính lot từ % balance
KILL_DD_PCT=3.0           # daily DD ≥ x% → bot tự tắt đến 00:00 UTC hôm sau

# --- Runtime ---
DRY_RUN=true
LOG_LEVEL=INFO
